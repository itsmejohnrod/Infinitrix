# Copy to .env. The defaults are for local development only.
APP_ENV=development
BASE_URL=http://localhost:8000
# Generate a value with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_PATH=instance/infinitrix.sqlite3
# console writes LOCAL verification codes into instance/mailbox.log.
# Switch to smtp before sharing or hosting the app.
MAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
# Create a Google Web application OAuth client. Callback:
# http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# API questions have a bundled fallback if the provider is unavailable.
TRIVIA_API_ENABLED=true
